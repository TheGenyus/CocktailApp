<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:paddingBottom="24dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMyIngredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:title="@string/title_my_ingredients"
        android:titleTextColor="@color/text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvMyIngredientCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_filter_ingredients">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/myIngredientFilterInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <GridLayout
                android:id="@+id/myIngredientContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="1"
                android:orientation="horizontal"
                android:padding="4dp" />
        </androidx.core.widget.NestedScrollView>

        <Button
            android:id="@+id/btnSaveMyIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save_my_ingredients"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnClearMyIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_clear_my_ingredients"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/bg_surface_variant"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</LinearLayout>
